# --- Database ---
# Neon PostgreSQL の接続文字列。
# Neon コンソール → Project → Connection Details から取得。
# Vercel deploy 時は Pooled connection (推奨) を使う:
#   postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# ローカル開発は Direct connection でも Pooled でも OK。
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# --- Admin ---
ADMIN_PASSWORD="change-me-to-something-strong"

# --- Email (Gmail SMTP) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-account@gmail.com"
SMTP_PASS="your-app-password-without-spaces"
SMTP_FROM="サロン名 <your-account+alias@gmail.com>"
