# =============================================================
# Database — Supabase (Tokyo: ap-northeast-1) 推奨
# =============================================================
# Supabase ダッシュボード > Project Settings > Database > Connection string
# から以下の 2 つの URL をコピーする。
#
# - DATABASE_URL : "Transaction" pooler (port 6543) — アプリのランタイム用
#                  必ず ?pgbouncer=true&connection_limit=1 を末尾に付けること
# - DIRECT_URL   : "Direct connection" or "Session" pooler (port 5432)
#                  prisma db push / マイグレーション用
DATABASE_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# =============================================================
# 管理画面のパスワード
# =============================================================
# 本番では推測されにくい長めの文字列に。Vercel の環境変数にも同じ値を設定。
ADMIN_PASSWORD="change-me-to-something-strong"

# =============================================================
# Email (Gmail SMTP)
# =============================================================
# Gmail のアプリパスワードを使用（2段階認証を有効化した上で発行）。
# SMTP_FROM の表示名 + アドレスは + エイリアス OK。
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-account@gmail.com"
SMTP_PASS="your-app-password-without-spaces"
SMTP_FROM="Beauty Salon TAKI <your-account+taki@gmail.com>"
